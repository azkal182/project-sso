# Staging-only configuration template. Inject real values outside Git.
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=replace-with-staging-secret
ACCOUNT_DB_PASSWORD=replace-with-staging-account-db-secret
KEYCLOAK_ADMIN=staging-bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-staging-bootstrap-secret
MANAGEMENT_CLIENT_SECRET=replace-with-staging-runtime-service-account-secret
ACCOUNT_MANAGEMENT_CLIENT_SECRET=replace-with-staging-oidc-client-secret
SESSION_SECRET=replace-with-staging-session-secret
KEYCLOAK_PUBLIC_URL=https://sso.staging.example.com
ACCOUNT_MANAGEMENT_PUBLIC_URL=https://admin.staging.example.com
FRONTEND_ORIGINS=https://admin.staging.example.com
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_CALLBACK_MAX=20
RATE_LIMIT_API_MAX=240
KEYCLOAK_REQUEST_TIMEOUT_MS=5000
TLS_CERTIFICATE_FILE=/etc/nginx/tls/tls.crt
TLS_CERTIFICATE_KEY_FILE=/etc/nginx/tls/tls.key
