# Copy to .env.production and inject real values through your secret manager.
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=replace-with-secret-manager-value
ACCOUNT_DB_PASSWORD=replace-with-separate-account-db-secret
KEYCLOAK_ADMIN=bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-one-time-bootstrap-secret
MANAGEMENT_CLIENT_SECRET=replace-with-runtime-service-account-secret
ACCOUNT_MANAGEMENT_CLIENT_SECRET=replace-with-oidc-client-secret
SESSION_SECRET=replace-with-session-secret
KEYCLOAK_PUBLIC_URL=https://sso.example.com
ACCOUNT_MANAGEMENT_PUBLIC_URL=https://admin.example.com
FRONTEND_ORIGINS=https://admin.example.com
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_CALLBACK_MAX=20
RATE_LIMIT_API_MAX=240
KEYCLOAK_REQUEST_TIMEOUT_MS=5000
TLS_CERTIFICATE_FILE=/etc/nginx/tls/tls.crt
TLS_CERTIFICATE_KEY_FILE=/etc/nginx/tls/tls.key
