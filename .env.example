# Development-only values. Copy to .env and replace every placeholder.
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me-local-postgres

# Used only by the one-shot bootstrap container to create the initial admin.
KEYCLOAK_ADMIN=bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-admin

# Runtime Account Management must use this client credential, never the admin above.
MANAGEMENT_CLIENT_SECRET=change-me-local-management-secret
ACCOUNT_MANAGEMENT_CLIENT_SECRET=change-me-local-account-client-secret
SESSION_SECRET=change-me-local-session-secret

# OIDC URL advertised to browser clients in the local environment.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Optional API protection limits per client IP per rolling minute.
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_CALLBACK_MAX=20
RATE_LIMIT_API_MAX=240
KEYCLOAK_REQUEST_TIMEOUT_MS=5000
